# Runtime identity (development, preview, or production)
APP_RUNTIME_ENV=development
APP_RUNTIME_NAME=mergifypdf
APP_RUNTIME_DB_LABEL=mergifypdf-development
APP_RUNTIME_GUARD_STRICT=true
APP_RUNTIME_REQUIRE_USERS=false

# Application and authentication
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-development-only-secret
DATABASE_URL=postgresql://user:password@localhost:5432/mergifypdf_development

# External services: use development/test resources only
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
R2_BUCKET_ENVIRONMENT=development
REDIS_ENVIRONMENT=development
EMAIL_DELIVERY_MODE=disabled

# Optional service credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Secure storage v2 remains disabled until isolated buckets and migration are ready.
STORAGE_MODEL_V2_ENABLED=false
R2_INCOMING_BUCKET=
R2_SOURCE_BUCKET=
R2_DERIVED_BUCKET=
R2_EXPECTED_ACCOUNT_ID=
R2_EXPECTED_INCOMING_BUCKET=
R2_EXPECTED_SOURCE_BUCKET=
R2_EXPECTED_DERIVED_BUCKET=
# Defaults: 1 GiB per PDF and 20 GiB total private storage per user.
SECURE_UPLOAD_MAX_BYTES=1073741824
SECURE_STORAGE_USER_QUOTA_BYTES=21474836480
STORAGE_INSPECTION_BATCH_SIZE=10
# Optional private scratch directory for a dedicated inspection worker.
STORAGE_INSPECTION_TMP_DIR=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
FROM_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_PROJECT_API_KEY=
