{
  "name": "mergifypdf",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:webpack": "node scripts/dev.mjs --webpack",
    "dev:clean": "node scripts/clean-dev-cache.mjs",
    "diagnose:dev": "node scripts/diagnose-dev.mjs",
    "benchmark:dev": "node scripts/benchmark-dev.mjs",
    "benchmark:hmr": "node scripts/benchmark-hmr.mjs",
    "endurance:dev": "node scripts/endurance-dev.mjs",
    "smoke:deploy": "node scripts/post-deploy-smoke.mjs",
    "storage:inspect": "tsx scripts/inspect-storage.ts",
    "build": "node scripts/build.mjs",
    "analyze": "ANALYZE=true node scripts/build.mjs",
    "deps:duplicates": "node scripts/report-duplicate-dependencies.mjs",
    "bundles:report": "node scripts/report-route-bundles.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:seed": "node scripts/seed-test-data.mjs",
    "test:e2e": "playwright test",
    "test:e2e:full": "playwright test --config=playwright.full.config.ts",
    "validate:env": "tsx scripts/validate-runtime-env.ts",
    "check": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test",
    "stripe:audit-duplicates": "node scripts/audit-stripe-duplicates.mjs",
    "safety:init": "node scripts/init-app-runtime-guard.mjs",
    "safety:env": "node scripts/check-env-db-drift.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-crypto/sha256-browser": "5.2.0",
    "@aws-sdk/client-s3": "^3.899.0",
    "@aws-sdk/s3-request-presigner": "^3.899.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.19.2",
    "@upstash/redis": "^1.34.3",
    "bcryptjs": "^3.0.2",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.553.0",
    "next": "16.2.6",
    "next-auth": "^4.24.13",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "posthog-js": "^1.352.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-dropzone": "^14.3.8",
    "react-qr-code": "^2.0.12",
    "resend": "^6.4.0",
    "simple-icons": "^16.0.0",
    "stripe": "^20.0.0"
  },
  "optionalDependencies": {
    "fontkit": "^2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@next/bundle-analyzer": "16.2.6",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "baseline-browser-mapping": "^2.10.13",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild"
    ]
  }
}
