{
  "name": "mergifypdf",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "NEXTAUTH_URL=http://localhost:3000 next dev --webpack --hostname 0.0.0.0 --port 3000",
    "dev:stable": "next dev --webpack",
    "dev:pty": "script -qec 'pnpm exec next dev --turbo' /dev/null",
    "dev:wasm": "NEXT_DISABLE_SWC_NATIVE=1 next dev --webpack",
    "dev:pty:wasm": "script -qec 'NEXT_DISABLE_SWC_NATIVE=1 pnpm exec next dev --webpack' /dev/null",
    "dev:turbo": "NEXTAUTH_URL=http://localhost:3000 next dev --turbo --hostname 0.0.0.0 --port 3000",
    "dev:webpack": "NEXTAUTH_URL=http://localhost:3000 next dev --webpack --hostname 0.0.0.0 --port 3000",
    "dev:lan": "echo 'Open on other devices: http://10.0.0.163:3000' && NEXTAUTH_URL=http://10.0.0.163:3000 next dev --webpack --hostname 0.0.0.0 --port 3000",
    "dev:lan:wasm": "echo 'Open on other devices: http://10.0.0.163:3000' && NEXTAUTH_URL=http://10.0.0.163:3000 NEXT_DISABLE_SWC_NATIVE=1 next dev --webpack --hostname 0.0.0.0 --port 3000",
    "dev:lan:turbo": "echo 'Open on other devices: http://10.0.0.163:3000' && NEXTAUTH_URL=http://10.0.0.163:3000 next dev --turbo --hostname 0.0.0.0 --port 3000",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build --webpack",
    "build:wasm": "NODE_OPTIONS='--max-old-space-size=4096' NEXT_DISABLE_SWC_NATIVE=1 next build --webpack",
    "build:stable": "pnpm build",
    "start": "next start",
    "start:lan": "echo 'Open on other devices: http://10.0.0.163:3000' && NEXTAUTH_URL=http://10.0.0.163:3000 next start --hostname 0.0.0.0 --port 3000",
    "prod:lan": "pnpm build:stable && pnpm start:lan",
    "lint": "eslint",
    "stripe:audit-duplicates": "node scripts/audit-stripe-duplicates.mjs",
    "safety:init": "node scripts/init-app-runtime-guard.mjs",
    "safety:env": "node scripts/check-env-db-drift.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.899.0",
    "@aws-sdk/s3-request-presigner": "^3.899.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.19.2",
    "@upstash/redis": "^1.34.3",
    "bcryptjs": "^3.0.2",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.553.0",
    "next": "16.0.7",
    "next-auth": "^4.24.13",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "posthog-js": "^1.352.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-dropzone": "^14.3.8",
    "react-qr-code": "^2.0.12",
    "resend": "^6.4.0",
    "simple-icons": "^16.0.0",
    "stripe": "^20.0.0"
  },
  "optionalDependencies": {
    "fontkit": "^2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.10.13",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas"
    ]
  }
}
